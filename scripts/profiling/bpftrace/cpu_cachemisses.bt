
config = {
    print_maps_on_exit = 0;
    max_map_keys = 4096;
}

hardware:cache-misses {
    @cpucachemisses[cpu] = count();
}

interval:s:1 {

    printf("%lld,", nsecs(tai));
    for ($kv : @cpucachemisses) {
        $cpu = $kv .0;
        $cachemisses = (uint32)$kv .1;

        printf("%d,%d,", $cpu, $cachemisses);
    }

    clear(@cpucachemisses);

    printf("\n");
}
