+    fn handle_invocation_error(&self, item: Arc<MQRequest>, cause: anyhow::Error) {
+        let recoverable =
+            cause.downcast_ref::<InsufficientMemoryError>().is_some()
+                || cause.downcast_ref::<InsufficientGPUError>().is_some();
+        if recoverable {
+            let fqdn = item.invoke.registration.fqdn.clone();
+            match self.mqfq_set.get_mut(&fqdn) {
+                Some(mut q) => {
+                    debug!(
+                        tid = item.invoke.tid,
+                        fqdn = %fqdn,
+                        error = %cause,
+                        "Recoverable launch failure; re-inserting invocation into MQFQ"
+                    );
+                    q.value_mut().reinsert_item(item);
+                    return;
+                },
+                None => {
+                    error!(tid=item.invoke.tid, fqdn=%fqdn, error=%cause, "Recoverable failure but flow queue missing; marking invocation error");
+                },
+            }
+        }
+
+        debug!(tid=item.invoke.tid, error=%cause, "Marking invocation as error");
+        item.invoke.mark_error(&cause);
     }
